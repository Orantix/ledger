generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PaymentMethod {
  BANK
  PERSONAL
  CREDIT
}

enum CaptureStatus {
  DRAFT
  PENDING_REVIEW
  POSTED
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

// Chart of accounts. Seeded with a minimal SME set; extensible per entity.
model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  journalLines           JournalLine[]
  rulesAsExpenseAccount  ClassificationRule[] @relation("ExpenseAccount")
  rulesAsPaymentAccount  ClassificationRule[] @relation("PaymentAccount")

  @@map("accounts")
}

// Deterministic mapping from (category, paymentMethod) -> double-entry accounts.
// Every rule is versioned so re-mapping is auditable, never a silent rewrite.
model ClassificationRule {
  id              String        @id @default(cuid())
  category        String
  paymentMethod   PaymentMethod
  expenseAccount  Account       @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  expenseAccountId String
  paymentAccount  Account       @relation("PaymentAccount", fields: [paymentAccountId], references: [id])
  paymentAccountId String
  version         Int           @default(1)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  captures  Capture[]

  @@unique([category, paymentMethod, version])
  @@index([category, paymentMethod, isActive])
  @@map("classification_rules")
}

// The plain-language entry a non-accountant makes. Never edited after posting;
// this is the audit trail's starting point alongside its attachments.
model Capture {
  id            String        @id @default(cuid())
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("LKR")
  date          DateTime
  paymentMethod PaymentMethod
  category      String
  notes         String?
  status        CaptureStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime      @default(now())

  appliedRule   ClassificationRule? @relation(fields: [appliedRuleId], references: [id])
  appliedRuleId String?

  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  journalEntryId String?       @unique

  attachments Attachment[]

  @@index([status])
  @@map("captures")
}

// First-class, permanently linked source document (receipt/invoice/bill).
model Attachment {
  id         String   @id @default(cuid())
  capture    Capture  @relation(fields: [captureId], references: [id])
  captureId  String
  filename   String
  mimeType   String
  sizeBytes  Int
  storagePath String
  uploadedAt DateTime @default(now())

  @@map("attachments")
}

// Immutable once posted. Corrections happen only via a reversing entry
// (reversalOf), never an edit — full audit trail.
model JournalEntry {
  id          String              @id @default(cuid())
  date        DateTime
  description String
  status      JournalEntryStatus  @default(POSTED)
  createdBy   String
  createdAt   DateTime            @default(now())

  reversalOf   JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversalOfId String?        @unique
  reversedBy   JournalEntry?  @relation("Reversal")

  lines    JournalLine[]
  capture  Capture?

  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  journalEntryId String
  account        Account      @relation(fields: [accountId], references: [id])
  accountId      String
  debit          Decimal      @db.Decimal(14, 2) @default(0)
  credit         Decimal      @db.Decimal(14, 2) @default(0)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}
