DATABASE_URL="postgresql://ledger:ledger@localhost:5432/orantix_ledger?schema=public"
PORT=3001
UPLOADS_DIR=uploads

# Required — the API refuses to boot without a real one. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of origins allowed to call the API. Unset = allow
# all origins (fine for local dev, not for anything public).
ALLOWED_ORIGINS=http://localhost:3000

# Seed-only: shared password for the dev users seed.ts creates (admin@orantix.local etc).
# Not used by seed:accounts/create-admin — see README "Deploying for real use".
SEED_PASSWORD=orantix123
