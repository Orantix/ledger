# Used by docker-compose.yml only. Copy to .env in this same directory.

# Required — generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated origins allowed to call the API. Defaults to
# http://localhost:8080 if unset. If anyone accesses this over the LAN
# from a different machine, add that origin too, e.g.:
#   http://localhost:8080,http://192.168.1.50:8080
ALLOWED_ORIGINS=http://localhost:8080

# Baked into the web app's JS bundle at build time — must be a
# host/IP the BROWSER can reach, not "localhost" unless every user is on
# this same machine. For LAN access from other devices, use this host's
# LAN IP, e.g. http://192.168.1.50:3001. Rebuild (docker compose up
# --build) after changing this — it won't take effect on a plain restart.
NEXT_PUBLIC_API_URL=http://localhost:3001
